APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WP_API_URL=https://wordpress.ghanatalksradio.com/wp-json/wp/v2
PORTAL_API_URL=https://app.ghanatalksradio.com

# Shared secret for POST /api/sitemap/dirty - same value must be configured
# on WordPress (the transition_post_status snippet) and on the portal
# (SITEMAP_WEBHOOK_SECRET). See EnsureSitemapWebhookKey.
SITEMAP_WEBHOOK_SECRET=

# Real-time re-crawl ping for Bing/Yandex (indexnow.org) - fired whenever
# the sitemap regenerates. Any random hex string works; it just has to
# match the key file written to public/{key}.txt (see IndexNowService and
# GenerateSitemap). Leave blank to disable - sitemap generation still
# works without it, IndexNow just won't fire.
INDEXNOW_KEY=

# 'api' (default) or 'db'. See AppServiceProvider::register().
WP_DATA_SOURCE=api
# WP_DB_HOST=
# WP_DB_PORT=3306
# WP_DB_DATABASE=
# WP_DB_USERNAME=
# WP_DB_PASSWORD=
# WP_DB_PREFIX=

# Universal Links (iOS) / App Links (Android) - see AppLinksController.
# Get these from whoever maintains the native app repos.
IOS_TEAM_ID=
IOS_BUNDLE_ID=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=
